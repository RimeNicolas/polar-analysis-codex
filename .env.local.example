# Local development and OpenAI Secure MCP Tunnel only.
# Copy to .env.local and replace every placeholder. Do not commit .env.local.

POLAR_CLIENT_ID=your-polar-client-id
POLAR_CLIENT_SECRET=your-polar-client-secret
# This must be a callback tunnel URL for this laptop, not the Render callback.
POLAR_REDIRECT_URI=https://your-temporary-callback-tunnel.example/polar/callback
POLAR_DEV_USER_ID=development-user

# Required only by ./start_local_mcp_tunnel.sh.
OPENAI_API_KEY=your-openai-api-key
POLAR_MCP_TUNNEL_ID=tunnel_YOUR_ID
