# Do not add real values to this file. Put local secrets in .env.local instead.
POLAR_CLIENT_ID=
POLAR_CLIENT_SECRET=
# This must be a public HTTPS callback registered in Polar AccessLink Admin.
POLAR_REDIRECT_URI=https://your-public-tunnel.example/polar/callback

# Development only: every MCP request maps to this one local user ID.
POLAR_DEV_USER_ID=development-user
# Optional: OpenAI Secure MCP Tunnel ID used by scripts/start_local_mcp_tunnel.sh.
# POLAR_MCP_TUNNEL_ID=tunnel_your_id
# Optional. The default is ~/.local/share/polar-mcp/credentials.sqlite3.
# POLAR_TOKEN_STORE=/absolute/private/path/polar-credentials.sqlite3

# Public Auth0/Render deployment only. Do not set MCP_AUTH_MODE=auth0 locally
# unless all values below are configured.
# MCP_AUTH_MODE=auth0
# MCP_PUBLIC_URL=https://polar-mcp.example.com
# AUTH0_DOMAIN=your-tenant.eu.auth0.com
# AUTH0_AUDIENCE=https://polar-mcp.example.com
# DATABASE_URL=postgresql://...  # Render Postgres internal URL, stored as a secret
